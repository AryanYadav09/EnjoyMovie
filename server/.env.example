# EnjoyMovie Server Environment Configuration

# Server Port
PORT=5000

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:5173

# The Movie Database (TMDB) API Credentials
# Get your free API key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=

# OMDb API Credentials (for IMDb ratings, Rotten Tomatoes & Metascore)
# Get your free API key at: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# Optional Redis Cache URL (falls back to high-performance in-memory cache if blank)
REDIS_URL=
